---
import '../styles/global.css';
import { site, nav, navPie, whatsappUrl, capacidad } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const fullTitle = title ? `${title} — ${site.nombre}` : `${site.nombre} — ${site.tagline}`;
const metaDesc = description ?? site.descripcion;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-name">{site.nombre}</span>
          <span class="brand-tag">{site.etiqueta}</span>
        </a>
        <nav>
          <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false">Menú</button>
          <ul class="nav-list" id="nav-list">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-principal header-cta" href={whatsappUrl} rel="noopener">Reservar</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <p class="footer-brand">{site.nombre}</p>
            <p>{site.lugar}</p>
            <p class="footer-nota">Para {capacidad}.</p>
          </div>
          <div>
            <p class="footer-title">Reservas</p>
            <p>
              <a href={whatsappUrl} rel="noopener">WhatsApp {site.whatsappVisible}</a><br />
              <a href={`https://www.instagram.com/${site.instagram}/`} rel="noopener">@{site.instagram}</a>
            </p>
            <p class="footer-nota">La reserva es directa, sin plataformas de intermediación.</p>
          </div>
          <div>
            <p class="footer-title">Sitio</p>
            <ul>
              {navPie.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="footer-final">Casa El Abrazo · Subachoque, Cundinamarca</p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const list = document.getElementById('nav-list');
      toggle?.addEventListener('click', () => {
        const abierto = list?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', abierto ? 'true' : 'false');
      });
    </script>
  </body>
</html>
