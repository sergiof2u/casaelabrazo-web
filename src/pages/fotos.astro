---
import Base from '../layouts/Base.astro';
---

<Base title="Fotos" description="Fotos de Casa El Abrazo, la cabaña de alquiler de fin de semana en Subachoque.">
  <section class="encabezado-pagina">
    <div class="container">
      <p class="etiqueta">Fotos</p>
      <h1>La cabaña, por fuera y por dentro</h1>
      <p class="entrada">La terraza, el jardín, los espacios de adentro y la montaña por el ventanal.</p>
    </div>
  </section>

  <section class="seccion" style="padding-top: 1rem">
    <div class="container">
      <div class="galeria galeria--mosaico">
        <figure>
          <img src="/fotos/portada.jpg" width="828" height="1100" alt="La cabaña con su terraza de madera, entre árboles" />
          <figcaption>La terraza, de frente al jardín.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/ventanal.jpg" width="602" height="800" loading="lazy" alt="La montaña, vista desde adentro de la cabaña" />
          <figcaption>La montaña, desde la sala.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/habitacion.jpg" width="677" height="900" loading="lazy" alt="La cama frente al ventanal, con la montaña al fondo" />
          <figcaption>La cama, frente al ventanal.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/cabana-jardin.jpg" width="1114" height="743" loading="lazy" alt="La cabaña vista desde el jardín" />
          <figcaption>La cabaña, desde el jardín.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/terraza.jpg" width="1087" height="743" loading="lazy" alt="La terraza de madera con el techo translúcido" />
          <figcaption>La terraza, donde se pasa el rato largo.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/terraza-mesa.jpg" width="1114" height="743" loading="lazy" alt="Mesa y sillas de madera en la terraza" />
          <figcaption>La mesa de la terraza, para el café de la mañana.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/sala-ventanales.jpg" width="1114" height="743" loading="lazy" alt="La sala con los ventanales al jardín" />
          <figcaption>La sala, con los ventanales al jardín.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/sofa-cama.jpg" width="1114" height="743" loading="lazy" alt="El sofá cama de la sala, junto a la mesa de centro" />
          <figcaption>El sofá cama de la sala.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/estufa-de-lena.jpg" width="1114" height="743" loading="lazy" alt="La estufa de leña con la leña apilada al lado" />
          <figcaption>La estufa de leña, para las noches frías.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/cama-doble.jpg" width="1114" height="743" loading="lazy" alt="La cama doble del dormitorio" />
          <figcaption>El dormitorio, con la cama doble.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/cocina.jpg" width="1114" height="743" loading="lazy" alt="La cocina con la estufa de gas y el lavaplatos" />
          <figcaption>La cocina, completa.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/bano.jpg" width="1067" height="1600" loading="lazy" alt="El baño con la ducha" />
          <figcaption>El baño, con ducha.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/cabana-arboles.jpg" width="1200" height="675" loading="lazy" alt="La cabaña entre los árboles al atardecer" />
          <figcaption>La cabaña, entre los árboles.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/jardin.jpg" width="1200" height="675" loading="lazy" alt="El jardín al atardecer" />
          <figcaption>El jardín, al atardecer.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/cabana/el-valle.jpg" width="1114" height="743" loading="lazy" alt="El valle visto desde el prado de la cabaña" />
          <figcaption>El valle, desde el prado.</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
