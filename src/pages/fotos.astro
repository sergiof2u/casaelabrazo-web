---
import Base from '../layouts/Base.astro';
---

<Base title="Fotos" description="Fotos de Casa El Abrazo, la cabaña de alquiler de fin de semana en Subachoque.">
  <section class="encabezado-pagina">
    <div class="container">
      <p class="etiqueta">Fotos</p>
      <h1>La cabaña, por fuera y por dentro</h1>
      <p class="entrada">La terraza, el jardín, la montaña por el ventanal y las manos que la construyeron.</p>
    </div>
  </section>

  <section class="seccion" style="padding-top: 1rem">
    <div class="container">
      <div class="galeria">
        <figure>
          <img src="/fotos/portada.jpg" width="828" height="1100" alt="La cabaña con su terraza de madera y la baranda calada" />
          <figcaption>La terraza, con la baranda calada en acero.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/la-casa.jpg" width="828" height="1100" loading="lazy" alt="La cabaña vista desde el jardín, con la escalera de madera" />
          <figcaption>La cabaña y el jardín, desde el prado.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/ventanal.jpg" width="602" height="800" loading="lazy" alt="La baranda calada y la montaña, vistas desde adentro" />
          <figcaption>La montaña, desde la sala.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/sala.jpg" width="602" height="800" loading="lazy" alt="La sala con la estufa de leña y la mesa de centro" />
          <figcaption>La sala, con la estufa de leña.</figcaption>
        </figure>
        <figure>
          <img src="/fotos/habitacion.jpg" width="677" height="900" loading="lazy" alt="La cama frente al ventanal, con la montaña al fondo" />
          <figcaption>La cama, frente al ventanal.</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
