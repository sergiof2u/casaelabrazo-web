---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  return paginas.map((pagina) => ({
    params: { pagina: pagina.id },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
---

<Base title={pagina.data.title} description={pagina.data.descripcion} image={pagina.data.imagen}>
  <section class="encabezado-pagina">
    <div class="container">
      <h1>{pagina.data.title}</h1>
      {pagina.data.entrada && <p class="entrada">{pagina.data.entrada}</p>}
    </div>
  </section>
  <section class="seccion" style="padding-top: 0">
    <div class="container">
      <article class="prose article">
        <Content />
      </article>
    </div>
  </section>
</Base>
