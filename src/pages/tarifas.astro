---
import Base from '../layouts/Base.astro';
import { whatsappUrl } from '../site';
import { tarifas, dosNoches, peso } from '../precios';
---

<Base title="Tarifas" description="Tarifas de Casa El Abrazo: la noche de fin de semana, la promoción de dos noches o más y el descuento de entre semana.">
  <section class="encabezado-pagina">
    <div class="container">
      <p class="etiqueta">Tarifas</p>
      <h1>Noches y precios</h1>
      <p class="entrada">
        Los precios están a la vista. Se reserva por WhatsApp o por correo, sin plataformas de intermediación.
      </p>
    </div>
  </section>

  <section class="seccion seccion--blanca" style="padding-top: 1rem">
    <div class="container">
      <div class="tarjetas">
        <div class="tarjeta">
          <h3>Una noche</h3>
          <p class="precio">{peso(tarifas.finDeSemana)}</p>
          <p class="detalle">Viernes, sábado o domingo. Es la tarifa de una noche sola.</p>
        </div>
        <div class="tarjeta tarjeta--destacada">
          <span class="insignia">Promoción</span>
          <h3>Dos noches o más</h3>
          <p class="precio">{peso(tarifas.promocionDosNoches)}</p>
          <p class="detalle">Por noche. Dos noches quedan en {peso(dosNoches)}.</p>
        </div>
        <div class="tarjeta">
          <h3>Entre semana</h3>
          <p class="precio">{peso(tarifas.entreSemana)}</p>
          <p class="detalle">Lunes a jueves, con el 10% de descuento sobre la tarifa de una noche.</p>
        </div>
      </div>

      <div class="prose" style="margin-top: 3rem">
        <h2>Lo que hay que saber</h2>
        <ul>
          <li>La promoción se aplica a partir de dos noches, y es la tarifa por noche.</li>
          <li>Las dos tarifas con descuento son excluyentes: aplica la promoción de dos noches o el descuento
            de lunes a jueves, nunca las dos a la vez.</li>
          <li>La cabaña es para una pareja con un niño.</li>
          <li>La entrada es a las 2:00 pm y la salida a las 12:00 m.</li>
          <li>La reserva se confirma por WhatsApp. Te enviamos la ubicación exacta y las indicaciones.</li>
        </ul>
        <p><a class="btn btn-principal" href={whatsappUrl} rel="noopener">Reservar por WhatsApp</a></p>
      </div>
    </div>
  </section>
</Base>
